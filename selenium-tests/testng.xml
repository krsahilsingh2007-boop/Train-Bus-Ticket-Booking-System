<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="RailBus Master Automation Test Suite" verbose="2" parallel="false">
    <listeners>
        <listener class-name="com.ticketbooking.utils.TestListener" />
    </listeners>

    <test name="End-to-End Functional Test Suite">
        <classes>
            <!-- 1. Authentication & Session Management -->
            <class name="com.ticketbooking.tests.AuthenticationTests">
                <methods>
                    <include name="testUserRegistration" />
                    <include name="testValidLogin" />
                    <include name="testInvalidLogin" />
                    <include name="testLogout" />
                    <include name="testAdminLogin" />
                    <include name="testUnauthorizedAccess" />
                </methods>
            </class>

            <!-- 2. Homepage & Journey Discovery -->
            <class name="com.ticketbooking.tests.SearchAndDiscoveryTests">
                <methods>
                    <include name="testHomepageLoading" />
                    <include name="testRailwaySearch" />
                    <include name="testBusSearch" />
                    <include name="testSourceDestinationValidation" />
                </methods>
            </class>

            <!-- 3. Seat Allocation & Concurrency Validation -->
            <class name="com.ticketbooking.tests.SeatSelectionTests">
                <methods>
                    <include name="testSeatSelection" />
                    <include name="testBookedSeatValidation" />
                </methods>
            </class>

            <!-- 4. Passenger Details & Payment Simulation -->
            <class name="com.ticketbooking.tests.BookingCheckoutTests">
                <methods>
                    <include name="testPassengerFormValidation" />
                    <include name="testPaymentFailure" />
                    <include name="testSuccessfulBooking" />
                    <include name="testBookingConfirmation" />
                    <include name="testTicketDownload" />
                </methods>
            </class>

            <!-- 5. History & Lifecycle Management -->
            <class name="com.ticketbooking.tests.BookingLifecycleTests">
                <methods>
                    <include name="testBookingHistory" />
                    <include name="testCancellation" />
                </methods>
            </class>
        </classes>
    </test>
</suite>
